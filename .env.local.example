# انسخ هذا الملف إلى .env.local (للتطوير) أو .env (لـ docker-compose) واملأ القيم الحقيقية
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# قاعدة البيانات (PostgreSQL) - مطلوبة لـ Prisma
# محليًا (خارج Docker): postgresql://USER:PASSWORD@localhost:5432/thaghur
# داخل docker-compose: يُبنى تلقائيًا من المتغيرات أدناه باستخدام اسم خدمة "db"
DATABASE_URL=postgresql://thaghur:changeme@localhost:5432/thaghur

# متغيرات docker-compose لخدمة PostgreSQL (لا تُستخدم مباشرة في الكود)
POSTGRES_USER=thaghur
POSTGRES_PASSWORD=changeme
POSTGRES_DB=thaghur
